---
import type { Publication } from '@/types/cv'
import { template } from '@/settings'

interface Props {
	listTitle: string
	listItems: Publication[]
}

const { listTitle, listItems } = Astro.props
---

<h2 class="mb-8 text-3xl font-bold">{listTitle}</h2>
<ul class="space-y-5">
	{listItems.map((item, index) => (
		<li class="rounded-box bg-base-200 p-5 sm:p-6">
			<h3 class="mb-2 text-lg font-semibold">
				<a class="link link-hover" href={`${template.base}/papers/#paper-${index + 1}`}>{item.title}</a>
			</h3>
			<p class="text-base-content/75">{[item.journal, item.time].filter(Boolean).join(' · ')}</p>
		</li>
	))}
</ul>
