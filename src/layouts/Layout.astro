---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content'

import BetterIcon from '../components/ui/BetterIcon.astro'
import ThemeSelector from '../components/ui/ThemeSelector.astro'
import Navbar from '../components/ui/Navbar.astro'
import Head from '../components/Head.astro'
import '../styles/global.css'

import { seo, profile, template } from '../settings'
import Footer from '../components/ui/Footer.astro'
import Search from '../components/ui/Search.astro'

const hasBlog = (await getCollection('blog')).length > 0

type Props = {
	title?: string
	description?: string
	image?: string
}

const {
	title = seo.default_title,
	description = seo.default_description,
	image = seo.default_image,
} = Astro.props
---

<!doctype html>
<html lang='en' data-theme={template.lightTheme}>
	<head>
		{template.transitions && <ClientRouter /> }

		<Head title={title} description={description} image={image} />



	</head>
	<body>
		<div class={`bg-base-100 drawer lg:drawer-open ${template.menu_left ? 'drawer-end' : ''}`}>
			<input id='my-drawer' type='checkbox' class='drawer-toggle' tabindex='-1' />
			<!-- Drawer content -->
            <div class='drawer-content bg-base-100'>
				<div class='bg-base-100 z-50 text-base-content shadow-sm'>
					<nav class='navbar'>
						<div class='navbar-start'>
							{template.menu_left &&
								<ThemeSelector />
							}
							<button type='button' data-drawer-trigger aria-label='Open site navigation' aria-controls='site-navigation' aria-expanded='false' class='btn btn-square btn-ghost lg:hidden'>
								<BetterIcon>
									<svg
										xmlns='http://www.w3.org/2000/svg'
										fill='none'
										viewBox='0 0 24 24'
										stroke-width='1.5'
										class='size-6 stroke-current'
									>
										<path
											stroke-linecap='round'
											stroke-linejoin='round'
											d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5'></path>
									</svg>
								</BetterIcon>
							</button>
						</div>
						<div class='navbar-center hidden text-lg font-black min-[360px]:inline-flex lg:hidden'>
							{profile.fullName}
						</div>
						<div class='navbar-end gap-3 sm:gap-4'>
							<Search {hasBlog} />
							{!template.menu_left &&
								<ThemeSelector />
							}
						</div>
					</nav>
				</div>
                <main class='mx-auto flex min-h-screen w-full max-w-5xl flex-col px-5 pt-10 sm:px-8 lg:pt-16'>
					<!-- Page content -->
					<slot />
				<Footer />
				</main>
			</div>
			<!-- Drawer side -->
			<div id='site-navigation' class='drawer-side z-40'>
				<label for='my-drawer' aria-label='close sidebar' class='drawer-overlay'
				></label>
				<Navbar {hasBlog} />
			</div>
		</div>
	</body>
</html>

<style>
	@media (prefers-color-scheme: dark) {
		:root {
			--my-color: #252b30;
		}
	}
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return
		const button = event.target.closest<HTMLButtonElement>('[data-drawer-trigger]')
		const drawer = document.querySelector<HTMLInputElement>('#my-drawer')
		if (button && drawer) drawer.click()
	})

	document.addEventListener('change', (event) => {
		if (!(event.target instanceof HTMLInputElement) || event.target.id !== 'my-drawer') return
		document.querySelector('[data-drawer-trigger]')?.setAttribute('aria-expanded', String(event.target.checked))
	})
</script>
