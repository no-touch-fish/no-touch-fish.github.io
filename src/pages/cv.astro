---
import Layout from '@/layouts/Layout.astro'
import CvTimeline from '@/components/ui/CvTimeline.astro'
import ArticleList from '@/components/ui/ArticleList.astro'
import { education, publications } from '@/data/cv'
import { template } from '@/settings'
---

<Layout title="CV | Junsheng Huang">
	<h1 class="mb-5 text-3xl font-bold">CV</h1>
	<div class="mb-10">
		<a href={`${template.base}/files/CV.pdf`} download class="btn btn-neutral">Download CV (PDF)</a>
	</div>

	<section class="mb-10">
		<h2 class="mb-6 border-b border-base-300 pb-2 text-2xl font-bold">Education</h2>
		<CvTimeline elements={education} colored={true} />
	</section>

	<section class="mb-10">
		<ArticleList listTitle="Publications" listItems={publications} />
	</section>

	<div class="mb-6 flex flex-wrap gap-3">
		<a href={`${template.base}/research/`} class="btn btn-outline">Research Experience</a>
		<a href={`${template.base}/teaching/`} class="btn btn-outline">Teaching &amp; Leadership</a>
	</div>
</Layout>
